generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Article {
  id            String                 @id @default(cuid())
  url           String                 @unique
  title         String
  description   String?
  content       String?
  author        String?
  imageUrl      String?
  source        String
  publishedAt   DateTime?
  createdAt     DateTime               @default(now())
  hashedContent String?
  embedding     Unsupported("vector")?
}
